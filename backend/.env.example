# FastAPI & Database Configuration
DATABASE_URL=postgresql://ecommerce_user:ecommerce_password@localhost:5432/ecommerce_db

# JWT & Security
SECRET_KEY=your-super-secret-key-change-this-in-production-use-strong-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# API Settings
API_TITLE=E-Commerce Analytics Platform API
API_VERSION=0.1.0
API_PREFIX=/api

# CORS Settings
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:3000", "http://127.0.0.1:5173"]

# Environment
ENVIRONMENT=development
DEBUG=true
